{
  "name": "@hoddy-ui/monorepo",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "build:next": "yarn --cwd packages/core/next build",
    "dev:next": "yarn --cwd packages/core/next dev",
    "start:test": "yarn --cwd test/my-app start"
  },
  "workspaces": [
    "packages/*",
    "packages/core/next",
    "test/*"
  ],
  "devDependencies": {
    "patch-package": "^7.0.0",
    "postinstall-postinstall": "^2.1.0",
    "react-native-size-matters": "^0.4.2",
    "tsup": "^7.2.0",
    "typescript": "~5.8.3"
  },
  "dependencies": {}
}